{
  "name": "dfsha-aj",
  "services": {
    "etcd1": {
      "image": "gcr.io/etcd-development/etcd:v3.6.15",
      "container_name": "dfsha-aj-etcd1",
      "labels": {
        "Proyecto": "DFSha-AJ"
      },
      "networks": [
        "etcd"
      ],
      "ports": [
        "127.0.0.1:23791:2379"
      ],
      "volumes": [
        "./.private/certs/ca.pem:/certs/ca.pem:ro",
        "./.private/certs/etcd1.pem:/certs/etcd1.pem:ro",
        "./.private/certs/etcd1.key:/certs/etcd1.key:ro",
        "etcd1:/etcd-data"
      ],
      "command": [
        "/usr/local/bin/etcd",
        "--name",
        "etcd1",
        "--data-dir",
        "/etcd-data",
        "--initial-cluster-token",
        "dfsha-aj-20261108",
        "--initial-cluster",
        "etcd1=https://etcd1:2380,etcd2=https://etcd2:2380,etcd3=https://etcd3:2380",
        "--listen-client-urls",
        "https://0.0.0.0:2379",
        "--advertise-client-urls",
        "https://etcd1:2379",
        "--listen-peer-urls",
        "https://0.0.0.0:2380",
        "--initial-advertise-peer-urls",
        "https://etcd1:2380",
        "--cert-file",
        "/certs/etcd1.pem",
        "--key-file",
        "/certs/etcd1.key",
        "--trusted-ca-file",
        "/certs/ca.pem",
        "--client-cert-auth",
        "--peer-cert-file",
        "/certs/etcd1.pem",
        "--peer-key-file",
        "/certs/etcd1.key",
        "--peer-trusted-ca-file",
        "/certs/ca.pem",
        "--peer-client-cert-auth",
        "--tls-min-version",
        "TLS1.3"
      ]
    },
    "etcd2": {
      "image": "gcr.io/etcd-development/etcd:v3.6.15",
      "container_name": "dfsha-aj-etcd2",
      "labels": {
        "Proyecto": "DFSha-AJ"
      },
      "networks": [
        "etcd"
      ],
      "ports": [
        "127.0.0.1:23792:2379"
      ],
      "volumes": [
        "./.private/certs/ca.pem:/certs/ca.pem:ro",
        "./.private/certs/etcd2.pem:/certs/etcd2.pem:ro",
        "./.private/certs/etcd2.key:/certs/etcd2.key:ro",
        "etcd2:/etcd-data"
      ],
      "command": [
        "/usr/local/bin/etcd",
        "--name",
        "etcd2",
        "--data-dir",
        "/etcd-data",
        "--initial-cluster-token",
        "dfsha-aj-20261108",
        "--initial-cluster",
        "etcd1=https://etcd1:2380,etcd2=https://etcd2:2380,etcd3=https://etcd3:2380",
        "--listen-client-urls",
        "https://0.0.0.0:2379",
        "--advertise-client-urls",
        "https://etcd2:2379",
        "--listen-peer-urls",
        "https://0.0.0.0:2380",
        "--initial-advertise-peer-urls",
        "https://etcd2:2380",
        "--cert-file",
        "/certs/etcd2.pem",
        "--key-file",
        "/certs/etcd2.key",
        "--trusted-ca-file",
        "/certs/ca.pem",
        "--client-cert-auth",
        "--peer-cert-file",
        "/certs/etcd2.pem",
        "--peer-key-file",
        "/certs/etcd2.key",
        "--peer-trusted-ca-file",
        "/certs/ca.pem",
        "--peer-client-cert-auth",
        "--tls-min-version",
        "TLS1.3"
      ]
    },
    "etcd3": {
      "image": "gcr.io/etcd-development/etcd:v3.6.15",
      "container_name": "dfsha-aj-etcd3",
      "labels": {
        "Proyecto": "DFSha-AJ"
      },
      "networks": [
        "etcd"
      ],
      "ports": [
        "127.0.0.1:23793:2379"
      ],
      "volumes": [
        "./.private/certs/ca.pem:/certs/ca.pem:ro",
        "./.private/certs/etcd3.pem:/certs/etcd3.pem:ro",
        "./.private/certs/etcd3.key:/certs/etcd3.key:ro",
        "etcd3:/etcd-data"
      ],
      "command": [
        "/usr/local/bin/etcd",
        "--name",
        "etcd3",
        "--data-dir",
        "/etcd-data",
        "--initial-cluster-token",
        "dfsha-aj-20261108",
        "--initial-cluster",
        "etcd1=https://etcd1:2380,etcd2=https://etcd2:2380,etcd3=https://etcd3:2380",
        "--listen-client-urls",
        "https://0.0.0.0:2379",
        "--advertise-client-urls",
        "https://etcd3:2379",
        "--listen-peer-urls",
        "https://0.0.0.0:2380",
        "--initial-advertise-peer-urls",
        "https://etcd3:2380",
        "--cert-file",
        "/certs/etcd3.pem",
        "--key-file",
        "/certs/etcd3.key",
        "--trusted-ca-file",
        "/certs/ca.pem",
        "--client-cert-auth",
        "--peer-cert-file",
        "/certs/etcd3.pem",
        "--peer-key-file",
        "/certs/etcd3.key",
        "--peer-trusted-ca-file",
        "/certs/ca.pem",
        "--peer-client-cert-auth",
        "--tls-min-version",
        "TLS1.3"
      ]
    }
  },
  "networks": {
    "etcd": {}
  },
  "volumes": {
    "etcd1": {
      "labels": {
        "Proyecto": "DFSha-AJ"
      }
    },
    "etcd2": {
      "labels": {
        "Proyecto": "DFSha-AJ"
      }
    },
    "etcd3": {
      "labels": {
        "Proyecto": "DFSha-AJ"
      }
    }
  }
